# Aplicação
PORT=3000

# Banco de Dados (PostgreSQL / MikroORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering_local

# Mensageria (AWS SQS / LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo